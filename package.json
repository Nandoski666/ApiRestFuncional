{
  "name": "api-avistamientos-aves",
  "version": "1.0.0",
  "description": "API REST para registrar avistamientos de aves, con pruebas unitarias y de integración (ISW-2, Sesiones 17 y 22)",
  "main": "server.js",
  "author": "Hernando Javier García Mogollón",
  "license": "MIT",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js test/unit",
    "test:integracion": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js test/integracion",
    "cobertura": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "html"
    ]
  }
}
